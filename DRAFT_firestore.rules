rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection validation probe (no PII)
    match /test/{docId} {
      allow get: if docId == 'connection';
      allow list, write: if false;
    }

    // --- Reusable Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'prince89761@gmail.com'
      );
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'securityScore', 'language', 'theme', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'role', 'securityScore', 'language', 'theme', 'notificationsEnabled', 'weeklyDigest', 'privacyStrictMode', 'totalScans', 'threatsDetected', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.role in ['user', 'admin']
        && data.securityScore is number && data.securityScore >= 0 && data.securityScore <= 100
        && data.language in ['en', 'hi', 'mr']
        && data.theme in ['dark', 'light']
        && (!('notificationsEnabled' in data) || data.notificationsEnabled is bool)
        && (!('weeklyDigest' in data) || data.weeklyDigest is bool)
        && (!('privacyStrictMode' in data) || data.privacyStrictMode is bool)
        && (!('totalScans' in data) || (data.totalScans is int && data.totalScans >= 0 && data.totalScans <= 1000000))
        && (!('threatsDetected' in data) || (data.threatsDetected is int && data.threatsDetected >= 0 && data.threatsDetected <= 1000000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll(['uid', 'email', 'emailVerified', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'emailVerified', 'updatedAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.emailVerified is bool
        && data.updatedAt is timestamp;
    }

    function isValidScanRecord(data) {
      return data.keys().hasAll(['id', 'userId', 'scanType', 'targetSummary', 'verdict', 'threatLevel', 'confidenceScore', 'riskScore', 'explainableSummary', 'status', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'scanType', 'targetSummary', 'verdict', 'threatLevel', 'confidenceScore', 'riskScore', 'explainableSummary', 'triggeredFeatures', 'recommendations', 'status', 'createdAt'])
        && isValidId(data.id)
        && isValidId(data.userId)
        && data.scanType in ['url', 'email', 'screenshot', 'qr']
        && data.targetSummary is string && data.targetSummary.size() >= 1 && data.targetSummary.size() <= 500
        && data.verdict in ['Safe', 'Suspicious', 'Phishing']
        && data.threatLevel in ['Low', 'Medium', 'High', 'Critical']
        && data.confidenceScore is number && data.confidenceScore >= 0 && data.confidenceScore <= 100
        && data.riskScore is number && data.riskScore >= 0 && data.riskScore <= 100
        && data.explainableSummary is string && data.explainableSummary.size() >= 1 && data.explainableSummary.size() <= 4000
        && (!('triggeredFeatures' in data) || (data.triggeredFeatures is list && data.triggeredFeatures.size() <= 20 && (data.triggeredFeatures.size() == 0 || data.triggeredFeatures[0] is string)))
        && (!('recommendations' in data) || (data.recommendations is list && data.recommendations.size() <= 10 && (data.recommendations.size() == 0 || data.recommendations[0] is string)))
        && data.status in ['completed', 'archived']
        && data.createdAt is timestamp;
    }

    function isValidThreatReport(data) {
      return data.keys().hasAll(['id', 'userId', 'scanId', 'title', 'scanType', 'verdict', 'threatLevel', 'confidenceScore', 'riskScore', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'scanId', 'title', 'scanType', 'verdict', 'threatLevel', 'confidenceScore', 'riskScore', 'createdAt'])
        && isValidId(data.id)
        && isValidId(data.userId)
        && isValidId(data.scanId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.scanType in ['url', 'email', 'screenshot', 'qr']
        && data.verdict in ['Safe', 'Suspicious', 'Phishing']
        && data.threatLevel in ['Low', 'Medium', 'High', 'Critical']
        && data.confidenceScore is number && data.confidenceScore >= 0 && data.confidenceScore <= 100
        && data.riskScore is number && data.riskScore >= 0 && data.riskScore <= 100
        && data.createdAt is timestamp;
    }

    function isValidThreatIntel(data) {
      return data.keys().hasAll(['id', 'title', 'category', 'severity', 'summary', 'pattern', 'mitigation', 'publishedAt'])
        && data.keys().hasOnly(['id', 'title', 'category', 'severity', 'summary', 'pattern', 'mitigation', 'publishedAt'])
        && isValidId(data.id)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 80
        && data.severity in ['Low', 'Medium', 'High', 'Critical']
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 2000
        && data.pattern is string && data.pattern.size() >= 1 && data.pattern.size() <= 500
        && data.mitigation is string && data.mitigation.size() >= 1 && data.mitigation.size() <= 1000
        && data.publishedAt is timestamp;
    }

    function isValidSecurityTip(data) {
      return data.keys().hasAll(['id', 'title', 'category', 'content', 'orderIndex'])
        && data.keys().hasOnly(['id', 'title', 'category', 'content', 'orderIndex'])
        && isValidId(data.id)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 150
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 80
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 1000
        && data.orderIndex is int && data.orderIndex >= 0 && data.orderIndex <= 1000;
    }

    function isValidLearningArticle(data) {
      return data.keys().hasAll(['id', 'topic', 'title', 'summary', 'content', 'readMinutes', 'difficulty'])
        && data.keys().hasOnly(['id', 'topic', 'title', 'summary', 'content', 'readMinutes', 'difficulty'])
        && isValidId(data.id)
        && data.topic is string && data.topic.size() >= 1 && data.topic.size() <= 80
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 500
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 8000
        && data.readMinutes is int && data.readMinutes >= 1 && data.readMinutes <= 120
        && data.difficulty in ['Beginner', 'Intermediate', 'Advanced'];
    }

    function isValidAdminMember(data) {
      return data.keys().hasAll(['uid', 'grantedBy', 'createdAt'])
        && data.keys().hasOnly(['uid', 'grantedBy', 'createdAt'])
        && isValidId(data.uid)
        && isValidId(data.grantedBy)
        && data.createdAt is timestamp;
    }

    // --- Collection Rules ---

    // 1. Users Collection (Operational profile without email PII)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == request.auth.uid
        && incoming().role == 'user'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(userId)
            && incoming().role == existing().role
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'securityScore', 'language', 'theme',
              'notificationsEnabled', 'weeklyDigest', 'privacyStrictMode',
              'totalScans', 'threatsDetected', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(userId) && isAdmin();

      // Isolated Private PII subcollection
      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && docId == 'info' && (isOwner(userId) || isAdmin());
        allow list: if false;
        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(docId)
          && docId == 'info'
          && isOwner(userId)
          && isValidUserPrivateInfo(incoming())
          && incoming().uid == request.auth.uid
          && incoming().updatedAt == request.time;
        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(docId)
          && docId == 'info'
          && (isOwner(userId) || isAdmin())
          && isValidUserPrivateInfo(incoming())
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'emailVerified', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(docId) && isAdmin();
      }
    }

    // 2. Scans Collection
    match /scans/{scanId} {
      allow get: if isValidId(scanId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser()
        && isValidId(scanId)
        && isValidScanRecord(incoming())
        && incoming().id == scanId
        && incoming().userId == request.auth.uid
        && incoming().status == 'completed'
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isVerifiedUser()
        && isValidId(scanId)
        && isValidScanRecord(incoming())
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && (
          isAdmin() ||
          (
            existing().userId == request.auth.uid
            && existing().status != 'archived'
            && incoming().status == 'archived'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status'])
          )
        );
      allow delete: if isVerifiedUser()
        && isValidId(scanId)
        && (existing().userId == request.auth.uid || isAdmin());
    }

    // 3. Reports Collection
    match /reports/{reportId} {
      allow get: if isValidId(reportId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser()
        && isValidId(reportId)
        && isValidThreatReport(incoming())
        && incoming().id == reportId
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/scans/$(incoming().scanId))
        && get(/databases/$(database)/documents/scans/$(incoming().scanId)).data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if isVerifiedUser()
        && isValidId(reportId)
        && (existing().userId == request.auth.uid || isAdmin());
    }

    // 4. Threat Intelligence Collection (Non-PII security advisories)
    match /threatIntelligence/{intelId} {
      allow get: if isValidId(intelId) && isSignedIn();
      allow list: if isSignedIn();
      allow create, update: if isValidId(intelId) && isAdmin() && isValidThreatIntel(incoming()) && incoming().id == intelId;
      allow delete: if isValidId(intelId) && isAdmin();
    }

    // 5. Security Tips Collection (Non-PII cyber hygiene tips)
    match /securityTips/{tipId} {
      allow get: if isValidId(tipId) && isSignedIn();
      allow list: if isSignedIn();
      allow create, update: if isValidId(tipId) && isAdmin() && isValidSecurityTip(incoming()) && incoming().id == tipId;
      allow delete: if isValidId(tipId) && isAdmin();
    }

    // 6. Learning Articles Collection (Non-PII educational content)
    match /learningArticles/{articleId} {
      allow get: if isValidId(articleId) && isSignedIn();
      allow list: if isSignedIn();
      allow create, update: if isValidId(articleId) && isAdmin() && isValidLearningArticle(incoming()) && incoming().id == articleId;
      allow delete: if isValidId(articleId) && isAdmin();
    }

    // 7. Admins Roster
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isValidId(adminId) && isAdmin() && isValidAdminMember(incoming()) && incoming().uid == adminId;
      allow delete: if isValidId(adminId) && isAdmin();
    }
  }
}
